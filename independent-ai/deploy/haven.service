[Unit]
Description=Haven private cloud AI and storage
After=network.target

[Service]
Type=simple
User=haven
Group=haven
WorkingDirectory=/opt/haven
EnvironmentFile=/etc/haven/haven.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/haven/.venv/bin/python /opt/haven/run.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/haven

[Install]
WantedBy=multi-user.target
