# Server-only configuration template. Not installed or activated by this task.
HAVEN_CLOUD_ONLY=1
HAVEN_DATA_DIR=/var/lib/haven
HAVEN_BIND_HOST=127.0.0.1
HAVEN_PORT=7860
HAVEN_ALLOWED_HOSTS=ai.example.invalid
